{
  "name": "gentlemans-bar-kasse",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Gentlemans Bar – Kasse und Umsatzübersicht",
  "engines": {
    "node": ">=22.17.0 <23"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env server.js",
