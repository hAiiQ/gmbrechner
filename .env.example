# Lokal ist keine Datenbankinstallation nötig. Daten liegen in ./data.
PORT=3000
# Auf Render automatisch durch render.yaml verbunden:
DATABASE_URL=
# Optional: gemeinsames Bar-Passwort ändern. Leer nutzt das vereinbarte Passwort.
BAR_PASSWORD=
# Für externe PostgreSQL-Verbindungen nur falls der Anbieter TLS verlangt:
# PGSSLMODE=require
